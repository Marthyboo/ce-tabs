<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="46">
  <CheatEntries>
    <CheatEntry>
      <ID>100</ID>
      <Description>"Instant Break  [primary - AOB hook]"</Description>
      <Options moAlwaysHideChildren="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Game   : Minecraft.Windows.exe (Bedrock, Win x64)
  Purpose: every block breaks on the first tick.
  Method : hook the break-progress store and force the stored value to 1.0f.
           No fixed addresses - everything is found by AOB scan at enable time,
           so a game update cannot point this at the wrong code.

  AOB anchor (verified unique, 1 hit):
    F3 0F 11 7E 24            movss [rsi+24], xmm7     = break progress store
    48 8B 45 18               mov rax, [rbp+18]
    48 39 86 98 00 00 00      cmp [rsi+98], rax
  The 4 offsets (98 00 00 00) are wildcarded because struct offsets shift
  between builds. The instruction itself is stolen whole (exactly 5 bytes),
  so the hook never splits an instruction.
}

[ENABLE]
aobscanmodule(ibWrite, Minecraft.Windows.exe, F3 0F 11 7E 24 48 8B 45 18 48 39 86 ?? ?? ?? ??)
alloc(ibCode, $100, ibWrite)
label(ibReturn)
registersymbol(ibWrite)

ibCode:
  db B8 00 00 80 3F        // mov eax, 0x3F800000   ; 1.0f
  db 66 0F 6E F8           // movd xmm7, eax        ; xmm7 = 1.0f
  db F3 0F 11 7E 24        // movss [rsi+24], xmm7  ; original store, now always 1.0
  jmp ibReturn

ibWrite:
  jmp ibCode
ibReturn:

[DISABLE]
ibWrite:
  db F3 0F 11 7E 24
unregistersymbol(ibWrite)
dealloc(ibCode)</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>101</ID>
      <Description>"Instant Break  [alt - threshold = 0]"</Description>
      <Options moAlwaysHideChildren="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Game   : Minecraft.Windows.exe (Bedrock, Win x64)
  Purpose: every block breaks on the first tick.
  Method : the completion test is  progress >= 0.99999f  against the constant
           at RVA 0xE827524. This finds that constant by its bytes and rewrites
           it to 0.0f, so "progress >= 0" is always true.

  AOB anchor (verified unique, 1 hit):
    58 FF 7F 3F   = 0.99999f  (completion threshold)
    D7 A3 F0 3E   = 0.47f     (progress multiplier that follows it)

  Use either this entry or the primary one - not both.
}

[ENABLE]
aobscanmodule(ibThreshold, Minecraft.Windows.exe, 58 FF 7F 3F D7 A3 F0 3E)
fullAccess(ibThreshold, 4)
registersymbol(ibThreshold)
ibThreshold:
  db 00 00 00 00           // 0.99999f -> 0.0f

[DISABLE]
ibThreshold:
  db 58 FF 7F 3F           // 0.99999f restored
unregistersymbol(ibThreshold)</AssemblerScript>
    </CheatEntry>
  </CheatEntries>
</CheatTable>
