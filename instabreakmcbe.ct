  <CheatEntries>
    <CheatEntry>
      <ID>0</ID>
      <Description>"instant break"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]

aobscanmodule(INJECT,Minecraft.Windows.exe,F3 0F 59 C6 F3 0F 58 06 F3 0F 11 06 48 8B 45 EF)
alloc(newmem,$1000,INJECT)
alloc(value,4)

label(return)

value:
dd (float)15.0

newmem:
  movss xmm0,[value]
  movss [rsi],xmm0
  mov rax,[rbp-11]
  jmp return

INJECT:
  jmp newmem
  nop 7
return:

registersymbol(INJECT)


[DISABLE]

INJECT:
  db F3 0F 59 C6 F3 0F 58 06 F3 0F 11 06 48 8B 45 EF

unregistersymbol(INJECT)
dealloc(newmem)
dealloc(value)
</AssemblerScript>
    </CheatEntry>
  </CheatEntries>
